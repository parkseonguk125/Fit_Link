# Database (Docker PostgreSQL)
DATABASE_URL="postgresql://exercise:exercise@localhost:5432/exercise_log?schema=public"

# NextAuth
AUTH_SECRET="local-dev-secret-change-me-in-production"
AUTH_URL="http://localhost:3000"

# MinIO (Docker object storage for images)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="record-images"

# App
NODE_ENV="development"
