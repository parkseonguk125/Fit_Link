# Database (Fit Link Docker PostgreSQL — port 5433, hanwhagreen과 충돌 방지)
DATABASE_URL="postgresql://exercise:exercise@localhost:5433/exercise_log?schema=public"

# NextAuth — trustHost로 localhost / LAN IP 모두 지원
AUTH_SECRET="local-dev-secret-change-me-in-production"
AUTH_TRUST_HOST="true"

# 로컬 dev(npm run dev)만 필요 — 접속하는 주소와 맞출 것
# AUTH_URL="http://localhost:3000"

# 네이버 메일 SMTP
# 1) mail.naver.com → 환경설정 → POP3/IMAP → "IMAP/SMTP 사용" 켜기
# 2) 네이버 MY → 보안설정 → 2단계 인증 → 애플리케이션 비밀번호 생성
# 3) SMTP_PASS에는 로그인 비밀번호가 아닌 "앱 비밀번호"를 입력
SMTP_HOST="smtp.naver.com"
SMTP_PORT="465"
SMTP_USER="your@naver.com"
SMTP_PASS="your-naver-app-password"
SMTP_FROM="psw000125@naver.com"

# true: SMTP 미설정 시에만 API/화면에 인증 코드 노출 (E2E 테스트용)
AUTH_EMAIL_DEV_EXPOSE="false"

# Local file uploads (Docker / npm run dev — Vercel은 Blob 사용)
UPLOAD_DIR="./uploads"

# Vercel Blob (Vercel Storage 연결 시 자동 설정)
# BLOB_READ_WRITE_TOKEN=""

# App
NODE_ENV="development"
