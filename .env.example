# Database (Fit Link Docker PostgreSQL — port 5433, hanwhagreen과 충돌 방지)
DATABASE_URL="postgresql://exercise:exercise@localhost:5433/exercise_log?schema=public"

# NextAuth — trustHost로 localhost / LAN IP 모두 지원
AUTH_SECRET="local-dev-secret-change-me-in-production"
AUTH_TRUST_HOST="true"

# 로컬 dev(npm run dev)만 필요 — 접속하는 주소와 맞출 것
# AUTH_URL="http://localhost:3000"

# Local file uploads
UPLOAD_DIR="./uploads"

# App
NODE_ENV="development"
