generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  TRAINER
}

enum Category {
  DIET
  EXERCISE
  CARDIO
}

enum ExercisePart {
  CHEST
  SHOULDER
  BACK
  LEGS
  ARMS
  CORE
  OTHER
}

enum CardioType {
  RUNNING
  CYCLING
  WALKING
  SWIMMING
  HIIT
  ROWING
  ELLIPTICAL
  JUMP_ROPE
  TRACKING
  HIKING
  SPINNING
  AEROBICS
  ZUMBA
  BROADCAST_DANCE
  SPORTS_DANCE
  STAIRMASTER
  OTHER
}

enum Visibility {
  PRIVATE
  FOLLOWERS
  PUBLIC
}

enum MediaType {
  IMAGE
  YOUTUBE
  LINK
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

enum VerificationPurpose {
  SIGNUP
  PASSWORD_RESET
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  emailVerified DateTime?
  displayName  String
  bio          String    @default("")
  role         Role      @default(USER)
  trainerRegion    String @default("")
  trainerGymName   String @default("")
  trainerPosition  String @default("")
  trainerCareer    String @default("")
  friendRequestsSeenAt DateTime?
  createdAt    DateTime  @default(now())
  records      Record[]
  comments     Comment[]
  followers    Follow[]  @relation("following")
  following    Follow[]  @relation("follower")
  accounts     Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model EmailVerification {
  id        String              @id @default(cuid())
  email     String
  codeHash  String
  purpose   VerificationPurpose
  verified  Boolean             @default(false)
  expiresAt DateTime
  createdAt DateTime            @default(now())

  @@index([email, purpose])
}

model Record {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category
  exercisePart ExercisePart?
  cardioType         CardioType?
  cardioDurationHours Int?
  cardioDurationMin  Int?
  cardioDistanceKm   Float?
  cardioCalories     Int?
  cardioHeartRateBpm Int?
  recordDate   DateTime      @db.Date
  feltNote     String        @default("")
  hardNote     String        @default("")
  lackingNote  String        @default("")
  questionNote String        @default("")
  visibility   Visibility    @default(PRIVATE)
  createdAt    DateTime      @default(now())
  media        RecordMedia[]
  comments     Comment[]
  dietItems    DietItem[]
  exerciseEntries ExerciseEntry[]

  @@index([userId, recordDate])
  @@index([visibility, createdAt])
}

model DietItem {
  id                 String @id @default(cuid())
  recordId           String
  record             Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  foodName           String
  matchedName        String @default("")
  servingLabel       String
  caloriesPerServing Int
  servings           Float  @default(1)
  totalCalories      Int
  sortOrder          Int    @default(0)

  @@index([recordId, sortOrder])
}

model ExerciseEntry {
  id           String        @id @default(cuid())
  recordId     String
  record       Record        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  exerciseKey  String
  exerciseName String
  sortOrder    Int           @default(0)
  sets         ExerciseSet[]

  @@index([recordId, sortOrder])
  @@index([exerciseKey])
}

model ExerciseSet {
  id              String        @id @default(cuid())
  exerciseEntryId String
  exerciseEntry   ExerciseEntry @relation(fields: [exerciseEntryId], references: [id], onDelete: Cascade)
  setNumber       Int
  weightKg        Float?
  reps            Int?
  sortOrder       Int           @default(0)

  @@index([exerciseEntryId, setNumber])
}

model RecordMedia {
  id          String    @id @default(cuid())
  recordId    String
  record      Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  mediaType   MediaType
  url         String
  storagePath String?
  sortOrder   Int       @default(0)
}

model Comment {
  id        String   @id @default(cuid())
  recordId  String
  record    Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([recordId, createdAt])
}

model Follow {
  followerId  String
  follower    User         @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User         @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  status      FollowStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  @@id([followerId, followingId])
  @@index([followingId, status])
}
